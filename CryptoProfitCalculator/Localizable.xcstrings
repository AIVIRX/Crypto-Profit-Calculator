          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întrebări scurte și concise care îți îmbunătățesc IQ-ul crypto."
          }
        },
        "gu" : {
          "stringUnit" : {
            "value" : "ટૂંકા, તીખા પ્રશ્નો જે તમારા ક્રિપ્ટો IQ ને તીખું કરે છે.",
