    "Short, sharp questions that sharpen your crypto IQ." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questions courtes et percutantes qui aiguisent votre QI crypto."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ചുരുങ്ങിയ, കുത്തിയ ചോദ്യങ്ങൾ നിങ്ങളുടെ ക്രിപ്റ്റോ IQ sharpen ചെയ്യുന്നു."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krátke, ostré otázky, ktoré zvyšujú vašu krypto IQ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लघु, तीव्र प्रश्न जे तुमच्या क्रिप्टो IQ ला धारदार करतात."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "value" : "Short, sharp questions that sharpen your crypto IQ.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domande brevi e incisive che affilano il tuo QI crypto."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "簡短、尖銳的問題，提升你的加密貨幣智商。",
